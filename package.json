{
  "name": "hermes-spotlight",
  "version": "0.1.0",
  "description": "A keyboard-first Hermes assistant overlay for Windows",
  "author": "Hermes Spotlight",
  "type": "module",
  "main": "dist-electron/main/main.cjs",
  "scripts": {
    "dev": "npm run build:main && node scripts/dev.mjs",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "prebuild:main": "node scripts/clean-main.cjs",
    "build:all": "npm run build:main && npm run build",
    "dist:win": "npm run build:all && electron-builder --win nsis",
    "postbuild:main": "node scripts/postbuild-main.cjs",
    "preview": "vite preview",
    "start": "node scripts/start-electron.cjs",
    "test": "npm run build:main && node --test tests/stream-json.test.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.23",
    "@types/react-dom": "~18.3.5",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "~5.6.2",
    "vite": "^7.3.7"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "build": {
    "appId": "com.hermes.spotlight",
    "productName": "Hermes Spotlight",
    "asar": true,
    "asarUnpack": [
      "scripts/hermes-overlay-python/**",
      "scripts/**/*.py",
      "src/audio/**/*.py"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "scripts/**/*",
      "src/audio/**/*",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Hermes-Spotlight-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Hermes Spotlight"
    }
  }
}
